package authctx

import (
	"context"
	"strings"
)

type Claims struct {
	UserID, SellerID, SessionID string
	Roles                       []string
}

type claimsKey struct{}

func WithClaims(ctx context.Context, claims Claims) context.Context {
	claims.UserID = strings.TrimSpace(claims.UserID)
	claims.SellerID = strings.TrimSpace(claims.SellerID)
	claims.SessionID = strings.TrimSpace(claims.SessionID)
	return context.WithValue(ctx, claimsKey{}, claims)
}

func ClaimsFrom(ctx context.Context) (Claims, bool) {
	claims, ok := ctx.Value(claimsKey{}).(Claims)
	return claims, ok && claims.UserID != ""
}

func HasRole(claims Claims, roles ...string) bool {
	for _, actual := range claims.Roles {
		for _, expected := range roles {
			if strings.EqualFold(strings.TrimSpace(actual), strings.TrimSpace(expected)) { return true }
		}
	}
	return false
}
