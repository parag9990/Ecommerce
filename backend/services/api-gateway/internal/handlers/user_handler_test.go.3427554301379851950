func TestGetMeRequiresAuthContext(t *testing.T) {
	handler := NewUserHandler(&fakeUserClient{}, testLogger())
	req := httptest.NewRequest(http.MethodGet, "/api/v1/me", nil)
	rr := httptest.NewRecorder()

	handler.GetMe(rr, req)

	if rr.Code != http.StatusUnauthorized {
		t.Fatalf("status = %d, want %d", rr.Code, http.StatusUnauthorized)
	}
}

func TestGetMeUsesAuthenticatedUserID(t *testing.T) {
	fake := &fakeUserClient{
		getUserFunc: func(ctx context.Context, req *userv1.GetUserRequest) (*userv1.UserProfile, error) {
			if req.GetUserId() != "user_123" {
				t.Fatalf("user_id = %q, want user_123", req.GetUserId())
			}
			md, ok := metadata.FromOutgoingContext(ctx)
			if !ok || len(md.Get("x-user-id")) == 0 || md.Get("x-user-id")[0] != "user_123" {
				t.Fatalf("outgoing metadata x-user-id = %#v", md.Get("x-user-id"))
			}
			return &userv1.UserProfile{UserId: "user_123", Email: "buyer@example.com", FullName: "Aarav Sharma"}, nil
		},
	}
	handler := NewUserHandler(fake, testLogger())
	req := requestWithClaims(http.MethodGet, "/api/v1/me", nil, authctx.Claims{
		UserID: "user_123",
		Roles:  []string{"buyer"},
	})
	rr := httptest.NewRecorder()

	handler.GetMe(rr, req)

	if rr.Code != http.StatusOK {
		t.Fatalf("status = %d, want %d", rr.Code, http.StatusOK)
	}
}

