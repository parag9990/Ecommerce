func requestWithClaims(method string, target string, body io.Reader, claims authctx.Claims) *http.Request {
	req := httptest.NewRequest(method, target, body)
	return req.WithContext(authctx.WithClaims(req.Context(), claims))
}

func assertValidationField(t *testing.T, body io.Reader, field string) {
	t.Helper()

	var response struct {
		Error *apiError `json:"error"`
	}
	if err := json.NewDecoder(body).Decode(&response); err != nil {
		t.Fatalf("decode response: %v", err)
	}
	if response.Error == nil {
		t.Fatal("expected error payload")
	}
	if response.Error.Code != "VALIDATION_ERROR" {
		t.Fatalf("error code = %q, want VALIDATION_ERROR", response.Error.Code)
	}
	for _, fieldErr := range response.Error.Fields {
		if fieldErr.Field == field {
			return
		}
	}
	t.Fatalf("field %q not found in %#v", field, response.Error.Fields)
}

func testLogger() *slog.Logger {
	return slog.New(slog.NewTextHandler(io.Discard, nil))
}

