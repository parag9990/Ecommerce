package handlers

import (
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net/http"

	"ecommerce/api-gateway/internal/middleware"
	sharedvalidation "github.com/parag/ecommerce/backend/shared/validation"
)

const maxRequestBodyBytes = 1 << 20

type apiResponse[T any] struct {
	Data      T         `json:"data"`
	RequestID string    `json:"request_id"`
	Error     *apiError `json:"error"`
}

type apiError struct {
	Code    string                        `json:"code"`
	Message string                        `json:"message"`
	Fields  []sharedvalidation.FieldError `json:"fields,omitempty"`
}

func writeData[T any](w http.ResponseWriter, r *http.Request, status int, data T) {
	writeJSON(w, status, apiResponse[T]{
		Data:      data,
		RequestID: middleware.RequestIDFromRequest(r),
		Error:     nil,
	})
}

func writeAPIError(w http.ResponseWriter, r *http.Request, status int, code string, message string) {
	writeJSON(w, status, apiResponse[any]{
		Data:      nil,
		RequestID: middleware.RequestIDFromRequest(r),
		Error: &apiError{
			Code:    code,
			Message: message,
		},
	})
}

func writeValidationError(w http.ResponseWriter, r *http.Request, validationErr sharedvalidation.Error) {
	writeJSON(w, http.StatusBadRequest, apiResponse[any]{
		Data:      nil,
		RequestID: middleware.RequestIDFromRequest(r),
		Error: &apiError{
			Code:    sharedvalidation.CodeValidationError,
			Message: "Request validation failed",
			Fields:  validationErr.Fields,
		},
	})
}

func writeJSON(w http.ResponseWriter, status int, body any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(body)
}

func decodeJSON(w http.ResponseWriter, r *http.Request, dst any) error {
	r.Body = http.MaxBytesReader(w, r.Body, maxRequestBodyBytes)

	decoder := json.NewDecoder(r.Body)
	decoder.DisallowUnknownFields()
	if err := decoder.Decode(dst); err != nil {
		if errors.Is(err, io.EOF) {
			return errors.New("request body is required")
		}
		return err
	}

	var extra any
	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
		if err == nil {
			return errors.New("request body must contain a single JSON object")
		}
		return fmt.Errorf("decode extra JSON: %w", err)
	}
	return nil
}
