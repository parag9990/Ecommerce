# Safe local template. Docker service names are used; replace them with localhost for host execution.
SERVICE_NAME=api-gateway
APP_ENV=local
HTTP_ADDR=:8080
API_BASE_PATH=/api/v1
API_CONTRACT_PATH=/app/config/master-api.json
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# Browser gRPC-Web facade.
GRPC_WEB_ENABLED=true
GRPC_ADDR=:9090
GRPC_WEB_POLICY_PATH=/app/config/grpcweb-policies.json
GRPC_WEB_EXPOSED_SERVICES=ecommerce.search.v1.SearchService,ecommerce.session.v1.SessionService,ecommerce.superadmin.v1.SuperadminService,ecommerce.cms.v1.CMSService
GRPC_WEB_MAX_RECEIVE_MESSAGE_BYTES=4194304
GRPC_WEB_MAX_SEND_MESSAGE_BYTES=4194304

# Reusable downstream gRPC clients. Several services are not gRPC-compatible yet.
GRPC_TLS_ENABLED=false
GRPC_DIAL_TIMEOUT=2s
# Local-only degraded startup; /health/ready still reports incompatible downstreams.
GRPC_ALLOW_UNAVAILABLE_DOWNSTREAMS=true
AUTH_GRPC_ADDR=auth-service:8081
AUTH_HTTP_URL=http://auth-service:8081
AUTH_HTTP_TIMEOUT=10s
USER_GRPC_ADDR=user-service:50052
PRODUCT_GRPC_ADDR=product-service:9092
CART_GRPC_ADDR=cart-service:8083
WISHLIST_GRPC_ADDR=wishlist-service:8084
ORDER_GRPC_ADDR=order-service:9094
PAYMENT_GRPC_ADDR=payment-service:8080
SEARCH_GRPC_ADDR=search-service:9085
CMS_GRPC_ADDR=cms-service:9098
SESSION_GRPC_ADDR=session-service:8086
SESSION_HTTP_URL=http://session-service:8086
SESSION_HTTP_TIMEOUT=30s
NOTIFICATION_GRPC_ADDR=notification-service:9090
SUPERADMIN_GRPC_ADDR=superadmin-service:8088

# Local dependencies
RATE_LIMIT_ENABLED=true
REDIS_ADDR=redis:6379
REDIS_PASSWORD=local_redis_password
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_DIAL_TIMEOUT=3s
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_ALLOWED_ALGS=RS256
JWT_JWKS_URL=http://auth-service:8081/.well-known/jwks.json
TRACE_ENABLED=true
TRACE_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
TRACE_EXPORTER_OTLP_INSECURE=true
OBSERVABILITY_HASH_SALT=local_gateway_hash_salt_change_me
METRICS_ENABLED=true
METRICS_ADDR=:9091
