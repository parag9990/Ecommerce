# Safe local template. Docker image generates throwaway RSA keys; use managed keys outside local dev.
AUTH_HTTP_ADDR=:8081
AUTH_MYSQL_DSN=root:local_password@tcp(mysql:3306)/auth_db?parseTime=true&multiStatements=true
AUTH_REDIS_ADDR=redis:6379
AUTH_REDIS_PASSWORD=local_redis_password
AUTH_REDIS_DB=1
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h
JWT_SIGNING_ALG=RS256
JWT_KEY_ID=local-dev-key
JWT_PRIVATE_KEY_PEM_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PEM_PATH=/app/keys/public.pem
REFRESH_TOKEN_PEPPER=local_refresh_token_pepper_change_me
OTP_HASH_PEPPER=local_otp_hash_pepper_change_me
OTP_RATE_LIMIT_PEPPER=local_otp_rate_pepper_change_me
NOTIFICATION_OTP_ENDPOINT=http://notification-service:8081/internal/v1/notifications/otp
SESSION_LINK_MODE=disabled
SESSION_EVENT_PEPPER=local_session_event_pepper_change_me
