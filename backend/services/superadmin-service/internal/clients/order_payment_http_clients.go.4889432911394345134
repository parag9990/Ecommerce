const defaultServiceAdminPath = "/internal/admin"

type HTTPOrderServiceClient struct {
	baseURL *url.URL
	client  *http.Client
	token   string
	logger  logging.Logger
}

func NewHTTPOrderServiceClient(baseURL string, token string, timeout time.Duration, logger logging.Logger) (*HTTPOrderServiceClient, error) {
	parsed, err := parseServiceBaseURL(baseURL, "order")
	if err != nil {
		return nil, err
	}
	token = strings.TrimSpace(token)
	if len(token) < 32 {
		return nil, fmt.Errorf("order service admin token must be at least 32 characters")
	}
	return &HTTPOrderServiceClient{
		baseURL: parsed,
		client:  &http.Client{Timeout: serviceTimeout(timeout)},
		token:   token,
		logger:  loggerOrNop(logger),
	}, nil
}

func (c *HTTPOrderServiceClient) ListOrdersForAdmin(ctx context.Context, req domain.AdminOrderListRequest, actor domain.AdminActor) (domain.AdminOrderListResponse, error) {
	var out domain.AdminOrderListResponse
	values := listQuery("", string(req.Status), req.Pagination)
	if req.UserID != "" {
		values.Set("user_id", req.UserID)
	}
	if req.SellerID != "" {
		values.Set("seller_id", req.SellerID)
	}
	if err := c.do(ctx, http.MethodGet, c.endpoint("/orders", values), nil, actor, "", "order", "", &out); err != nil {
		return domain.AdminOrderListResponse{}, err
	}
	return out, nil
}

func (c *HTTPOrderServiceClient) GetOrderForAdmin(ctx context.Context, orderID string, actor domain.AdminActor) (domain.OrderSnapshot, error) {
	var out domain.OrderSnapshot
	path := "/orders/" + url.PathEscape(orderID)
	if err := c.do(ctx, http.MethodGet, c.endpoint(path, nil), nil, actor, "", "order", orderID, &out); err != nil {
		return domain.OrderSnapshot{}, err
	}
	return out, nil
}

func (c *HTTPOrderServiceClient) GetOrderStatusHistory(ctx context.Context, orderID string, actor domain.AdminActor) ([]domain.OrderStatusEvent, error) {
	var out struct {
		History []domain.OrderStatusEvent `json:"history"`
	}
	path := "/orders/" + url.PathEscape(orderID) + "/status-history"
	if err := c.do(ctx, http.MethodGet, c.endpoint(path, nil), nil, actor, "", "order", orderID, &out); err != nil {
		return nil, err
	}
	return out.History, nil
}

func (c *HTTPOrderServiceClient) endpoint(path string, values url.Values) string {
	return serviceEndpoint(c.baseURL, path, values)
}

func (c *HTTPOrderServiceClient) do(ctx context.Context, method string, endpoint string, body any, actor domain.AdminActor, reason string, resourceType string, resourceID string, out any) error {
	return doAdminServiceRequest(ctx, c.client, c.logger, c.token, method, endpoint, body, actor, reason, resourceType, resourceID, out)
}

