func parseServiceBaseURL(baseURL string, serviceName string) (*url.URL, error) {
	baseURL = strings.TrimSpace(baseURL)
	if baseURL == "" {
		return nil, fmt.Errorf("%s service base url is required", serviceName)
	}
	parsed, err := url.Parse(baseURL)
	if err != nil {
		return nil, fmt.Errorf("parse %s service base url: %w", serviceName, err)
	}
	if parsed.Scheme != "http" && parsed.Scheme != "https" {
		return nil, fmt.Errorf("%s service base url must use http or https", serviceName)
	}
	if parsed.Host == "" {
		return nil, fmt.Errorf("%s service base url must include a host", serviceName)
	}
	return parsed, nil
}

func serviceTimeout(timeout time.Duration) time.Duration {
	if timeout <= 0 {
		return 5 * time.Second
	}
	return timeout
}

func loggerOrNop(logger logging.Logger) logging.Logger {
	if logger == nil {
		return logging.NewNop()
	}
	return logger
}

func serviceEndpoint(baseURL *url.URL, path string, values url.Values) string {
	u := *baseURL
	basePath := strings.TrimRight(u.Path, "/")
	if basePath == "" {
		basePath = defaultServiceAdminPath
	}
	u.Path = strings.TrimRight(basePath, "/") + "/" + strings.TrimLeft(path, "/")
	u.RawQuery = values.Encode()
	return u.String()
}

func doAdminServiceRequest(ctx context.Context, client *http.Client, logger logging.Logger, token string, method string, endpoint string, body any, actor domain.AdminActor, reason string, resourceType string, resourceID string, out any) error {
	var reader io.Reader
	if body != nil {
		payload, err := json.Marshal(body)
		if err != nil {
			return domain.NewInternal("marshal downstream admin request failed", err)
		}
		reader = bytes.NewReader(payload)
	}

	req, err := http.NewRequestWithContext(ctx, method, endpoint, reader)
	if err != nil {
		return domain.NewInternal("build downstream admin request failed", err)
	}
	req.Header.Set("Accept", "application/json")
	if body != nil {
		req.Header.Set("Content-Type", "application/json")
	}
	attachAdminHeaders(req.Header, actor, reason)
	req.Header.Set("Authorization", "Bearer "+token)

	resp, err := client.Do(req)
	if err != nil {
		logger.Warn(ctx, "downstream admin request failed",
			"method", method,
			"endpoint", endpoint,
			"resource_type", resourceType,
			"resource_id", resourceID,
			"request_id", actor.RequestID,
			"error", err,
		)
		return domain.NewDownstreamUnavailable(resourceType+" service is unavailable", err)
	}
	defer resp.Body.Close()

	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
		if out == nil {
			io.Copy(io.Discard, resp.Body)
			return nil
		}
		if err := json.NewDecoder(resp.Body).Decode(out); err != nil {
			return domain.NewDownstreamUnavailable(resourceType+" service returned an invalid response", err)
		}
		return nil
	}

	return mapAdminServiceError(resp, resourceType, resourceID)
}

func mapAdminServiceError(resp *http.Response, resourceType string, resourceID string) error {
	responseBody, _ := io.ReadAll(io.LimitReader(resp.Body, 4096))
	message := strings.TrimSpace(string(responseBody))

	switch resp.StatusCode {
	case http.StatusNotFound:
		switch resourceType {
		case "order":
			return domain.NewOrderNotFound(resourceID)
		case "payment":
			return domain.NewPaymentNotFound(resourceID)
		case "refund":
			return domain.NewRefundNotFound(resourceID)
		default:
			return domain.NewValidationError("resource was not found")
		}
	case http.StatusBadRequest:
		if message == "" {
			message = resourceType + " service rejected the request"
		}
		return domain.NewValidationError(message)
	case http.StatusConflict, http.StatusPreconditionFailed:
		if resourceType == "refund" {
			return domain.NewRefundNotReviewable("current")
		}
		if message == "" {
			message = resourceType + " service rejected the state transition"
		}
		return domain.NewValidationError(message)
	case http.StatusUnauthorized, http.StatusForbidden:
		return domain.NewDownstreamUnavailable(resourceType+" service denied the admin request", nil)
	case http.StatusTooManyRequests, http.StatusBadGateway, http.StatusServiceUnavailable, http.StatusGatewayTimeout:
		return domain.NewDownstreamUnavailable(resourceType+" service is unavailable", nil)
	default:
		if resp.StatusCode >= 500 {
			return domain.NewDownstreamUnavailable(resourceType+" service is unavailable", nil)
		}
		return domain.NewInternal(fmt.Sprintf("%s service returned unexpected status %d", resourceType, resp.StatusCode), nil)
	}
}
