# Docker values. Local dummy token/password values must be replaced outside local development.
SERVICE_NAME=superadmin-service
APP_ENV=local
HTTP_ADDR=:8088
SUPERADMIN_DATABASE_DSN=root:local_password@tcp(mysql:3306)/superadmin_db?parseTime=true&multiStatements=true
SUPERADMIN_REQUIRE_DATABASE=true
SUPERADMIN_LOG_LEVEL=info
USER_SERVICE_ADMIN_BASE_URL=http://user-service:50052
ORDER_SERVICE_ADMIN_BASE_URL=http://order-service:8090
PAYMENT_SERVICE_ADMIN_BASE_URL=http://payment-service:8080
SUPERADMIN_PLATFORM_SETTINGS_EVENT_TOPIC=platform.settings.events
