ORDER_HTTP_ADDR=:8090
ORDER_ADMIN_TOKEN=local_superadmin_internal_token_change_me
ORDER_MYSQL_DSN=root:local_password@tcp(mysql:3306)/order_db?parseTime=true&multiStatements=true

# Checkout and inventory compensation.
ORDER_INVENTORY_RESERVATION_TTL=15m
ORDER_INVENTORY_RELEASE_TIMEOUT=3s
ORDER_IDEMPOTENCY_TTL=24h

# Internal gRPC boundary.
ORDER_GRPC_ADDR=:9094
ORDER_GRPC_TRUSTED_CALLER_TOKEN=local_order_trusted_caller_token_change_me
ORDER_PAGE_TOKEN_SIGNING_KEY=local_order_page_token_signing_key_change_me

# Transactional order-event outbox.
ORDER_KAFKA_BROKERS=kafka:29092
ORDER_EVENTS_ENABLED=true
ORDER_EVENTS_TOPIC=order.events
ORDER_KAFKA_WRITE_TIMEOUT=10s
ORDER_OUTBOX_BATCH_SIZE=100
ORDER_OUTBOX_INTERVAL=1s
ORDER_OUTBOX_MAX_ATTEMPTS=8
ORDER_OUTBOX_INITIAL_BACKOFF=5s
ORDER_OUTBOX_MAX_BACKOFF=10m
ORDER_OUTBOX_STALE_LOCK_TIMEOUT=5m

# Payment coordination and trusted payment-result ingress.
ORDER_PAYMENT_RETURN_URL=https://localhost/checkout/payment-result
ORDER_PAYMENT_ALLOWED_CURRENCIES=INR,USD
ORDER_PAYMENT_INVENTORY_ACTION_TIMEOUT=3s
ORDER_CART_BASE_URL=http://cart-service:8083
ORDER_PRODUCT_BASE_URL=http://product-service:8082
ORDER_PRODUCT_SERVICE_TOKEN=local_product_service_token
ORDER_PAYMENT_BASE_URL=http://payment-service:8080
ORDER_PAYMENT_INTERNAL_TOKEN=local_payment_internal_token_change_me_32_chars
ORDER_PAYMENT_EVENTS_TOKEN=local_payment_events_token_change_me_32_chars
ORDER_DOWNSTREAM_REQUEST_TIMEOUT=5s
ORDER_PAYMENT_ACTION_TTL=10m
