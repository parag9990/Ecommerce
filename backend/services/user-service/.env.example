# Docker-local values. Never put production credentials in this file.
USER_SERVICE_GRPC_ADDRESS=:50052
USER_SERVICE_HTTP_ADDRESS=:9091
USER_SERVICE_HTTP_READ_HEADER_TIMEOUT=5s
USER_SERVICE_ADMIN_TOKEN=local_superadmin_internal_token_change_me
USER_SERVICE_SHUTDOWN_TIMEOUT=10s
USER_SERVICE_GRPC_REFLECTION=true
USER_SERVICE_DATABASE_DSN=root:local_password@tcp(mysql:3306)/user_db?parseTime=true&multiStatements=true
USER_SERVICE_DB_MAX_OPEN_CONNS=25
USER_SERVICE_DB_MAX_IDLE_CONNS=25
USER_SERVICE_DB_CONN_MAX_LIFETIME=5m
USER_SERVICE_DB_PING_TIMEOUT=5s
USER_SERVICE_VALIDATION_PHONE_REGION=IN
USER_SERVICE_LOG_LEVEL=info

USER_EVENTS_ENABLED=true
USER_EVENTS_PROVIDER=rabbitmq
USER_EVENTS_TOPIC=user.events
USER_EVENTS_DLQ=user.events.dlq

OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_BATCH_SIZE=100
OUTBOX_WORKER_POLL_INTERVAL=2s
OUTBOX_WORKER_LOCK_TTL=30s
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_PUBLISH_TIMEOUT=10s

RABBITMQ_URL=amqp://ecommerce:local_rabbitmq_password@rabbitmq:5672/ecommerce
KAFKA_BROKERS=kafka:29092
