func TestMySQLOutboxRepositoryInsert(t *testing.T) {
	db, mock, err := sqlmock.New()
	if err != nil {
		t.Fatalf("sqlmock.New returned error: %v", err)
	}
	defer db.Close()

	repo, err := NewMySQLOutboxRepository(db, WithLogger(testLogger()))
	if err != nil {
		t.Fatalf("NewMySQLOutboxRepository returned error: %v", err)
	}

	event := events.OutboxEvent{
		EventID:       "evt_123",
		EventType:     "UserCreated",
		EventVersion:  1,
		Topic:         "user.events",
		AggregateType: "user",
		AggregateID:   "user_123",
		Payload:       []byte(`{"event_id":"evt_123"}`),
		RequestID:     "req_123",
		TraceID:       "trace_123",
		OccurredAt:    fixedRepositoryTime(),
	}

	mock.ExpectExec(`(?s)INSERT INTO user_outbox_events`).
		WithArgs(
			event.EventID,
			event.EventType,
			event.EventVersion,
			event.Topic,
			event.AggregateType,
			event.AggregateID,
			string(event.Payload),
			event.RequestID,
			event.TraceID,
			event.OccurredAt,
		).
		WillReturnResult(sqlmock.NewResult(1, 1))

	if err := repo.Insert(context.Background(), event); err != nil {
		t.Fatalf("Insert returned error: %v", err)
	}
	if err := mock.ExpectationsWereMet(); err != nil {
		t.Fatalf("unmet sql expectations: %v", err)
	}
}

func TestMySQLOutboxRepositoryLockPending(t *testing.T) {
	db, mock, err := sqlmock.New()
	if err != nil {
		t.Fatalf("sqlmock.New returned error: %v", err)
	}
	defer db.Close()

	repo, err := NewMySQLOutboxRepository(db, WithLogger(testLogger()))
	if err != nil {
		t.Fatalf("NewMySQLOutboxRepository returned error: %v", err)
	}

	now := fixedRepositoryTime()
	rows := sqlmock.NewRows([]string{
		"id",
		"event_id",
		"event_type",
		"event_version",
		"topic",
		"aggregate_type",
		"aggregate_id",
		"payload",
		"request_id",
		"trace_id",
		"status",
		"attempts",
		"occurred_at",
	}).AddRow(int64(10), "evt_123", "UserCreated", 1, "user.events", "user", "user_123", []byte(`{"event_id":"evt_123"}`), "req_123", nil, "pending", 0, now)

	mock.ExpectBegin()
	mock.ExpectQuery(`(?s)SELECT.*FROM user_outbox_events.*FOR UPDATE SKIP LOCKED`).
		WithArgs(10).
		WillReturnRows(rows)
	mock.ExpectExec(`(?s)UPDATE user_outbox_events.*SET locked_until = \?.*WHERE id IN \(\?\)`).
		WithArgs(sqlmock.AnyArg(), int64(10)).
		WillReturnResult(sqlmock.NewResult(0, 1))
	mock.ExpectCommit()

	locked, err := repo.LockPending(context.Background(), 10, time.Minute)
	if err != nil {
		t.Fatalf("LockPending returned error: %v", err)
	}
	if len(locked) != 1 || locked[0].EventID != "evt_123" {
		t.Fatalf("locked rows = %#v", locked)
	}
	if err := mock.ExpectationsWereMet(); err != nil {
		t.Fatalf("unmet sql expectations: %v", err)
	}
}

