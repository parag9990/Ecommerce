func TestMySQLOutboxRepositoryStats(t *testing.T) {
	db, mock, err := sqlmock.New()
	if err != nil {
		t.Fatalf("sqlmock.New returned error: %v", err)
	}
	defer db.Close()

	repo, err := NewMySQLOutboxRepository(db, WithLogger(testLogger()))
	if err != nil {
		t.Fatalf("NewMySQLOutboxRepository returned error: %v", err)
	}

	mock.ExpectQuery(`(?s)SELECT.*COUNT\(\*\).*TIMESTAMPDIFF.*FROM user_outbox_events`).
		WillReturnRows(sqlmock.NewRows([]string{"pending", "oldest_age_microseconds"}).AddRow(int64(3), int64(2_500_000)))

	stats, err := repo.Stats(context.Background())
	if err != nil {
		t.Fatalf("Stats returned error: %v", err)
	}
	if stats.Pending != 3 || stats.OldestPendingAge != 2500*time.Millisecond {
		t.Fatalf("stats = %#v", stats)
	}
	if err := mock.ExpectationsWereMet(); err != nil {
		t.Fatalf("unmet sql expectations: %v", err)
	}
}
