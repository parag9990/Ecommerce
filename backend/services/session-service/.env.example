# Safe local defaults for the production Session Management Service runtime.
# Copy this file to .env and replace every change-me value outside local development.

# HTTP server
SESSION_HTTP_ADDR=:8086
SESSION_HTTP_READ_TIMEOUT=5s
SESSION_HTTP_WRITE_TIMEOUT=10s
SESSION_HTTP_IDLE_TIMEOUT=60s
SESSION_SHUTDOWN_TIMEOUT=10s
SESSION_ADMIN_TOKEN=local_superadmin_internal_token_change_me

# Session model and validation
SESSION_SCHEMA_VERSION=1
SESSION_INACTIVITY_TIMEOUT=30m
SESSION_DEFAULT_STATUS=active
SESSION_DEFAULT_CHANNEL=unknown
SESSION_DEFAULT_DEVICE_TYPE=unknown
SESSION_DEFAULT_IP_VERSION=unknown
SESSION_DEFAULT_RISK_LEVEL=unknown
SESSION_MAX_ID_LENGTH=128
SESSION_MAX_HASH_LENGTH=256
SESSION_MAX_PAGE_LENGTH=2048
SESSION_MAX_REFERRER_LENGTH=2048
SESSION_MAX_USER_AGENT_LENGTH=1024
SESSION_MAX_METADATA_LENGTH=128
SESSION_MAX_UTM_VALUE_LENGTH=256
SESSION_MAX_GEO_VALUE_LENGTH=128
SESSION_MAX_RISK_REASONS=20
SESSION_MAX_RISK_REASON_TEXT_LENGTH=256

# MongoDB durable storage
SESSION_MONGO_URI=mongodb://local_admin:local_mongo_password@mongodb:27017/?authSource=admin
SESSION_MONGO_DATABASE=session_db
SESSION_MONGO_CONNECT_TIMEOUT=5s

# Redis active-session and live-metrics storage
SESSION_REDIS_ADDR=redis:6379
SESSION_REDIS_PASSWORD=local_redis_password
SESSION_REDIS_DB=5
SESSION_REDIS_DIAL_TIMEOUT=2s
SESSION_REDIS_READ_TIMEOUT=2s
SESSION_REDIS_WRITE_TIMEOUT=2s
SESSION_REDIS_KEY_PREFIX=session
SESSION_ACTIVE_TTL=35m
SESSION_ACTIVE_COUNTER_TTL=48h

# Event ingestion
SESSION_INGEST_MAX_BODY_BYTES=65536
SESSION_ALLOWED_CLOCK_SKEW=5m
SESSION_MAX_EVENT_AGE=24h
SESSION_IP_HASH_SALT=local_session_ip_hash_salt_change_me
SESSION_MAX_EVENT_TYPE_LENGTH=64
SESSION_MAX_EVENT_PROPERTY_KEY_LENGTH=128
SESSION_MAX_EVENT_PROPERTY_STRING_LENGTH=2048
SESSION_MAX_EVENT_PROPERTIES=50
SESSION_MAX_EVENT_PROPERTY_DEPTH=6
SESSION_DEFAULT_LIST_LIMIT=100
SESSION_MAX_LIST_LIMIT=500

# Device tracking and privacy
SESSION_DEVICE_TRACKING_ENABLED=true
SESSION_STORE_USER_AGENT=true
SESSION_USER_AGENT_MAX_LENGTH=1024
SESSION_PRIVACY_HASH_PEPPER=local_session_privacy_hash_pepper_change_me
SESSION_PRIVACY_DELETION_LIST_LIMIT=50
SESSION_REPORT_MAX_RANGE_DAYS=366
SESSION_REPORT_MAX_ROWS=10000
SESSION_REPORT_MAX_BYTES=5242880
SESSION_REPORT_SCHEDULE_LIST_LIMIT=100
SESSION_TRUSTED_PROXY_CIDRS=
SESSION_GEOIP_ENABLED=false
SESSION_GEOIP_DB_PATH=
SESSION_GEOIP_TIMEOUT=20ms

# Journey reconstruction
SESSION_JOURNEY_DEFAULT_LIMIT=1000
SESSION_JOURNEY_MAX_LIMIT=1000
SESSION_JOURNEY_SUMMARY_TOP_PATHS_LIMIT=10
SESSION_JOURNEY_SUMMARY_UPSERT_ENABLED=true

# Heatmap query and aggregation
SESSION_HEATMAP_CLICK_BUCKET_SIZE=5
SESSION_HEATMAP_MAX_DATE_RANGE_DAYS=31
SESSION_HEATMAP_MAX_POINTS=5000
SESSION_HEATMAP_AGGREGATION_ENABLED=true
SESSION_HEATMAP_AGGREGATION_INTERVAL=1m
SESSION_HEATMAP_AGGREGATION_BATCH_SIZE=1000
SESSION_HEATMAP_AGGREGATION_INITIAL_LOOKBACK=1h
SESSION_HEATMAP_AGGREGATION_CHECKPOINT_LOOKBACK=5m
SESSION_HEATMAP_AGGREGATION_WORKER_NAME=heatmap_aggregator

# Analytics APIs and response caches
SESSION_ANALYTICS_LIVE_WINDOW=5m
SESSION_ANALYTICS_SESSION_LOOKBACK=24h
SESSION_ANALYTICS_MAX_SESSION_RANGE_DAYS=90
SESSION_ANALYTICS_DEFAULT_PAGE_SIZE=50
SESSION_ANALYTICS_MAX_PAGE_SIZE=100
SESSION_ANALYTICS_MAX_FUNNEL_RANGE_DAYS=90
SESSION_ANALYTICS_RAW_FALLBACK_RANGE=24h
SESSION_ANALYTICS_MIN_FUNNEL_STEPS=2
SESSION_ANALYTICS_MAX_FUNNEL_STEPS=8
SESSION_ANALYTICS_DEFAULT_FUNNEL_METRIC=funnel.checkout
SESSION_ANALYTICS_LIVE_CACHE_TTL=10s
SESSION_ANALYTICS_SESSIONS_CACHE_TTL=30s
SESSION_ANALYTICS_FUNNELS_CACHE_TTL=2m

# Retention policy and worker
SESSION_RAW_EVENT_TTL_DAYS=90
SESSION_METADATA_RETENTION_DAYS=365
SESSION_JOURNEY_RETENTION_DAYS=365
SESSION_HEATMAP_RETENTION_DAYS=730
SESSION_AGGREGATE_RETENTION_YEARS=5
SESSION_RETENTION_WORKER_BATCH_SIZE=1000
SESSION_RETENTION_WORKER_INTERVAL=1h
SESSION_RETENTION_DRY_RUN=false
SESSION_RETENTION_WORKER_RUN_ONCE=false
SESSION_SMALL_COHORT_THRESHOLD=5
SESSION_RETENTION_MAX_RANGE_DAYS=366
