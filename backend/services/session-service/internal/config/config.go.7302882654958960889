func (c EventIngestConfig) Validate() error {
	if c.MaxBodyBytes <= 0 {
		return errors.New("SESSION_INGEST_MAX_BODY_BYTES must be greater than zero")
	}
	if c.AllowedClockSkew <= 0 {
		return errors.New("SESSION_ALLOWED_CLOCK_SKEW must be greater than zero")
	}
	if c.MaxEventAge <= 0 {
		return errors.New("SESSION_MAX_EVENT_AGE must be greater than zero")
	}
	return nil
}

func (c DeviceTrackingConfig) Validate() error {
	if c.UserAgentMaxLength <= 0 {
		return errors.New("SESSION_USER_AGENT_MAX_LENGTH must be greater than zero")
	}
	if c.GeoIPTimeout <= 0 {
		return errors.New("SESSION_GEOIP_TIMEOUT must be greater than zero")
	}
	if c.GeoIPEnabled && strings.TrimSpace(c.GeoIPDBPath) == "" {
		return errors.New("SESSION_GEOIP_DB_PATH is required when SESSION_GEOIP_ENABLED=true")
	}
	for _, cidr := range c.TrustedProxyCIDRs {
		if _, _, err := net.ParseCIDR(strings.TrimSpace(cidr)); err != nil {
			return fmt.Errorf("SESSION_TRUSTED_PROXY_CIDRS contains invalid CIDR %q", cidr)
		}
	}
	return nil
}

func (c JourneyConfig) Validate() error {
	return usecase.JourneyConfig{
		DefaultLimit:         c.DefaultLimit,
		MaxLimit:             c.MaxLimit,
		SummaryTopPathsLimit: c.SummaryTopPathsLimit,
	}.Validate()
}

func (c HeatmapConfig) Validate() error {
	if err := (usecase.HeatmapQueryConfig{
		MaxDateRangeDays: c.MaxDateRangeDays,
		MaxPoints:        c.MaxPoints,
	}).Validate(); err != nil {
		return err
	}
	if err := (usecase.HeatmapAggregationConfig{
		BatchSize:          c.AggregationBatchSize,
		ClickBucketSize:    c.ClickBucketSize,
		WorkerName:         c.AggregationWorkerName,
		InitialLookback:    c.AggregationInitialLookback,
		CheckpointLookback: c.AggregationCheckpointLookback,
	}).Validate(); err != nil {
		return err
	}
	if c.AggregationInterval <= 0 {
		return errors.New("SESSION_HEATMAP_AGGREGATION_INTERVAL must be greater than zero")
	}
	return nil
}

func (c AnalyticsConfig) Validate() error {
	return usecase.AnalyticsConfig{
		LiveWindow:          c.LiveWindow,
		SessionLookback:     c.SessionLookback,
		MaxSessionRangeDays: c.MaxSessionRangeDays,
		DefaultPageSize:     c.DefaultPageSize,
