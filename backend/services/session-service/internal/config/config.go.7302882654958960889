func (c HTTPConfig) Validate() error {
	if strings.TrimSpace(c.Address) == "" {
		return errors.New("SESSION_HTTP_ADDR cannot be empty")
	}
	if c.ReadTimeout <= 0 {
		return errors.New("SESSION_HTTP_READ_TIMEOUT must be greater than zero")
	}
	if c.WriteTimeout <= 0 {
		return errors.New("SESSION_HTTP_WRITE_TIMEOUT must be greater than zero")
	}
	if c.IdleTimeout <= 0 {
		return errors.New("SESSION_HTTP_IDLE_TIMEOUT must be greater than zero")
	}
	if c.ShutdownTimeout <= 0 {
		return errors.New("SESSION_SHUTDOWN_TIMEOUT must be greater than zero")
	}
	return nil
}

func (c SessionModelConfig) Validate() error {
	if c.SchemaVersion != domain.CurrentSessionSchemaVersion {
		return fmt.Errorf("SESSION_SCHEMA_VERSION must be %d", domain.CurrentSessionSchemaVersion)
	}
	if c.InactivityTimeout <= 0 {
		return errors.New("SESSION_INACTIVITY_TIMEOUT must be greater than zero")
	}
	usecaseCfg := c.UsecaseConfig()
	return usecaseCfg.Validate()
}

func (c SessionModelConfig) UsecaseConfig() usecase.Config {
	return usecase.Config{
		SchemaVersion:     c.SchemaVersion,
		InactivityTimeout: c.InactivityTimeout,
		DefaultStatus:     domain.SessionStatus(strings.TrimSpace(c.DefaultStatus)),
		DefaultChannel:    domain.Channel(strings.TrimSpace(c.DefaultChannel)),
		DefaultDeviceType: domain.DeviceType(strings.TrimSpace(c.DefaultDeviceType)),
		DefaultIPVersion:  domain.IPVersion(strings.TrimSpace(c.DefaultIPVersion)),
		DefaultRiskLevel:  domain.RiskLevel(strings.TrimSpace(c.DefaultRiskLevel)),
		Validation: domain.ValidationConfig{
			MaxIDLength:             c.MaxIDLength,
			MaxHashLength:           c.MaxHashLength,
			MaxPageLength:           c.MaxPageLength,
			MaxReferrerLength:       c.MaxReferrerLength,
			MaxUserAgentLength:      c.MaxUserAgentLength,
			MaxMetadataLength:       c.MaxMetadataLength,
			MaxUTMValueLength:       c.MaxUTMValueLength,
			MaxGeoValueLength:       c.MaxGeoValueLength,
			MaxRiskReasons:          c.MaxRiskReasons,
			MaxRiskReasonTextLength: c.MaxRiskReasonTextLength,
		}.WithDefaults(),
	}
}

func (c StorageConfig) Validate() error {
	if err := c.MongoConfig().Validate(); err != nil {
		return err
	}
	if err := c.RedisClientConfig().Validate(); err != nil {
		return err
	}
	if err := c.ActiveSessionStoreConfig().Validate(); err != nil {
		return err
	}
	if c.RawEventTTLDays < 30 || c.RawEventTTLDays > 180 {
		return errors.New("SESSION_RAW_EVENT_TTL_DAYS must be between 30 and 180")
	}
	return c.StorageUsecaseConfig().Validate()
}

func (c StorageConfig) MongoConfig() repository.MongoConfig {
	return repository.MongoConfig{
		URI:            c.MongoURI,
		Database:       c.MongoDatabase,
		ConnectTimeout: c.MongoConnectTimeout,
	}
}

