			ActiveSessionTTL:             envDurationWithSeconds("SESSION_ACTIVE_TTL", "SESSION_ACTIVE_TTL_SECONDS", 35*time.Minute),
			ActiveCounterTTL:             envDurationWithSeconds("SESSION_ACTIVE_COUNTER_TTL", "SESSION_ACTIVE_COUNTER_TTL_SECONDS", 48*time.Hour),
			RawEventTTLDays:              envInt("SESSION_RAW_EVENT_TTL_DAYS", 90),
			DefaultListLimit:             envInt("SESSION_DEFAULT_LIST_LIMIT", 100),
			MaxListLimit:                 envInt("SESSION_MAX_LIST_LIMIT", 500),
			MaxEventTypeLength:           envInt("SESSION_MAX_EVENT_TYPE_LENGTH", defaultEventValidation.MaxEventTypeLength),
			MaxEventPropertyKeyLength:    envInt("SESSION_MAX_EVENT_PROPERTY_KEY_LENGTH", defaultEventValidation.MaxPropertyKeyLength),
