# Core service
NOTIFICATION_GRPC_ADDRESS=:9090
NOTIFICATION_ANALYTICS_HTTP_ADDRESS=:8081
NOTIFICATION_STARTUP_TIMEOUT=5s
NOTIFICATION_SHUTDOWN_TIMEOUT=10s

# MongoDB. Local Compose uses a transaction-capable replica set.
NOTIFICATION_MONGO_URI=mongodb://local_admin:local_mongo_password@mongodb:27017/?authSource=admin
NOTIFICATION_MONGO_DATABASE=notification_db
NOTIFICATION_MONGO_TEMPLATES_COLLECTION=notification_templates
NOTIFICATION_MONGO_DELIVERIES_COLLECTION=notification_deliveries
NOTIFICATION_MONGO_PREFERENCES_COLLECTION=notification_preferences
NOTIFICATION_MONGO_PROVIDER_EVENTS_COLLECTION=provider_events

# RabbitMQ event consumption and retry/DLQ
NOTIFICATION_RABBITMQ_URL=amqp://ecommerce:local_rabbitmq_password@rabbitmq:5672/ecommerce
NOTIFICATION_EVENT_CONSUMER_ENABLED=true
NOTIFICATION_ORDER_EVENTS_QUEUE=notification.order.events.v1
NOTIFICATION_PAYMENT_EVENTS_QUEUE=notification.payment.events.v1
NOTIFICATION_USER_EVENTS_QUEUE=notification.user.events.v1
NOTIFICATION_CONSUMER_PREFETCH=10
NOTIFICATION_RETRY_MAX_ATTEMPTS=4
NOTIFICATION_RETRY_DELAY_1=30s
NOTIFICATION_RETRY_DELAY_2=2m
NOTIFICATION_RETRY_DELAY_3=8m
NOTIFICATION_RETRY_PREFETCH=10
NOTIFICATION_RETRY_PUBLISH_CONFIRM_TIMEOUT=5s
NOTIFICATION_RETRY_ATTEMPT_LEASE=30s
# Local-only example. Replace with secret-managed base64 encoding of exactly 32 random bytes.
NOTIFICATION_DELIVERY_ENCRYPTION_KEY=bG9jYWxfbm90aWZpY2F0aW9uX2tleV8zMmJ5dGVzISE=

# SMTP email provider. Mailpit is the local capture server.
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_EMAIL_SMTP_HOST=mailpit
NOTIFICATION_EMAIL_SMTP_PORT=1025
NOTIFICATION_EMAIL_SMTP_TLS_MODE=none
NOTIFICATION_EMAIL_SMTP_USERNAME=
NOTIFICATION_EMAIL_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=no-reply@example.com
NOTIFICATION_EMAIL_TIMEOUT=5s

# Optional HTTP SMS provider
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_SMS_PROVIDER=http_gateway
NOTIFICATION_SMS_HTTP_ENDPOINT=http://localhost:18080/messages
NOTIFICATION_SMS_HTTP_BEARER_TOKEN=
NOTIFICATION_SMS_TIMEOUT=5s

# Push and WhatsApp-like contracts are available; adapters remain disabled until configured.
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_PROVIDER=
NOTIFICATION_WHATSAPP_LIKE_ENABLED=false
NOTIFICATION_WHATSAPP_LIKE_PROVIDER=

# Metrics and signed provider callbacks
NOTIFICATION_METRICS_ENABLED=true
NOTIFICATION_METRICS_PATH=/metrics
NOTIFICATION_PROVIDER_WEBHOOKS_ENABLED=false
NOTIFICATION_WEBHOOK_PATH_PREFIX=/internal/provider-webhooks
NOTIFICATION_WEBHOOK_MAX_BODY_BYTES=65536
NOTIFICATION_WEBHOOK_REPLAY_WINDOW_SECONDS=300
NOTIFICATION_EMAIL_WEBHOOK_SIGNING_SECRET=
NOTIFICATION_SMS_WEBHOOK_SIGNING_SECRET=
NOTIFICATION_PUSH_WEBHOOK_SIGNING_SECRET=
NOTIFICATION_WHATSAPP_LIKE_WEBHOOK_SIGNING_SECRET=
NOTIFICATION_EMAIL_OPEN_TRACKING_ENABLED=false
NOTIFICATION_SMS_OPEN_TRACKING_ENABLED=false
NOTIFICATION_PUSH_OPEN_TRACKING_ENABLED=false
NOTIFICATION_WHATSAPP_LIKE_OPEN_TRACKING_ENABLED=false
