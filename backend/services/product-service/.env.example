# Docker-local Product Service business runtime.
SERVICE_NAME=product-service
APP_ENV=local
PRODUCT_HTTP_ADDR=:8082
PRODUCT_MONGO_URI=mongodb://local_admin:local_mongo_password@mongodb:27017/?authSource=admin
PRODUCT_MONGO_DATABASE=product_db
PRODUCT_MONGO_AUTO_CREATE_COLLECTIONS=true
PRODUCT_EVENTS_ENABLED=true
PRODUCT_EVENT_BROKER=rabbitmq
PRODUCT_EVENTS_TOPIC=product.events
PRODUCT_OUTBOX_WORKER_ENABLED=true
RABBITMQ_URL=amqp://ecommerce:local_rabbitmq_password@rabbitmq:5672/ecommerce
PRODUCT_INTERNAL_SERVICE_TOKEN=local_product_service_token
LOG_LEVEL=info
