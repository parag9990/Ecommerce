# Providers are disabled by default. Configure sandbox values to test an adapter.
PAYMENT_HTTP_ADDR=:8080
PAYMENT_MYSQL_DSN=root:local_password@tcp(mysql:3306)/payment_db?parseTime=true&multiStatements=true
PAYMENT_ALLOWED_PROVIDERS=
PAYMENT_DEFAULT_PROVIDER=
PAYMENT_INTERNAL_API_TOKEN=local_payment_internal_token_change_me_32_chars
PAYMENT_RECONCILIATION_ENABLED=false
