  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let data = {};",
          "try { data = pm.response.json(); } catch (error) { data = {}; }",
          "const payload = data.data && typeof data.data === 'object' ? data.data : data;",
          "const tokens = payload.tokens || data.tokens || data;",
          "function save(key, value) {",
          "  if (value !== undefined && value !== null && String(value).trim() !== '') {",
          "    pm.environment.set(key, value);",
          "  }",
          "}",
          "if (tokens.access_token) {",
          "  save('access_token', tokens.access_token);",
          "  const user = payload.user || data.user || {};",
          "  const roles = Array.isArray(user.roles) ? user.roles : [];",
          "  if (roles.includes('seller')) save('seller_access_token', tokens.access_token);",
          "  else if (roles.includes('superadmin')) save('superadmin_access_token', tokens.access_token);",
          "  else if (roles.some((role) => ['admin', 'operations_admin', 'finance_admin', 'catalog_admin'].includes(role))) save('admin_access_token', tokens.access_token);",
          "  else save('buyer_access_token', tokens.access_token);",
          "}",
          "if (tokens.refresh_token) save('refresh_token', tokens.refresh_token);",
          "const keys = ['account_id','address_id','campaign_id','cart_id','category_id','challenge_id','coupon_id','event_id','item_id','order_id','payment_id','product_id','reconciliation_id','refund_id','request_id','resource_id','schedule_id','seller_id','session_id','synonym_id','user_id','variant_id'];",
          "for (const key of keys) {",
          "  save(key, payload[key] ?? data[key]);",
          "}",
          "if (payload.user && payload.user.user_id) save('user_id', payload.user.user_id);",
          "if (payload.user && payload.user.seller_id) save('seller_id', payload.user.seller_id);",
          "if (payload.tokens && payload.tokens.access_token) save('access_token', payload.tokens.access_token);"
        ]
      }
    }
